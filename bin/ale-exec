#!/bin/sh

usage() {
    cat <<'EOF'
usage: ale-exec --task T --agent A [--heartbeat-s N] [--usage-from codex-json|pi-json|none] [--base GITREF] -- command...

Limits:
  a timer heartbeat proves the process is alive, not that it progresses
  there is no path blocking; containment is detected only at verify --base
  lease loss interrupts between heartbeats, not before an in-flight write
  ALE_EXEC_GRACE_S overrides the child termination grace period (default: 10s)
  ALE_EXEC_TEE_WAIT_S bounds the wait for captured stdout to drain after the child exits (default: 60s)

Exit codes (ale-exec only; the ale CLI codes are unchanged):
  the child's own exit code after check and submit, 4 when the lease was lost, 3 on a lost claim
  75 the child hit an executor usage limit: an error or turn.failed row of the captured JSON output
    matches usage limit, quota exceeded, rate limit or 429, and either the child exited non-zero or
    the working tree is unchanged since it started (HEAD, git status and git diff HEAD as before,
    so an already-dirty tree counts when the child left it alone). ale-exec
    prints "ale-exec: usage-limit: <line>" to stderr, skips check and submit, raises input-required
    and leaves the task owned and unsubmitted for a fallback executor. The child's stdout is
    captured for this: held back until it exits with --usage-from codex-json or pi-json, and
    copied through tee as it streams with --usage-from none.
EOF
}

task=
agent=
heartbeat_s=120
usage_from=none
base=

while [ "$#" -gt 0 ]; do
    case "$1" in
        --help|-h) usage; exit 0 ;;
        --task) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; task=$2; shift 2 ;;
        --agent) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; agent=$2; shift 2 ;;
        --heartbeat-s) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; heartbeat_s=$2; shift 2 ;;
        --usage-from) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; usage_from=$2; shift 2 ;;
        --base) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; base=$2; shift 2 ;;
        --) shift; break ;;
        *) usage >&2; exit 2 ;;
    esac
done

[ -n "$task" ] && [ -n "$agent" ] && [ "$#" -gt 0 ] || { usage >&2; exit 2; }
case "$usage_from" in
    codex-json|pi-json|none) ;;
    *) echo "ale-exec: invalid --usage-from: $usage_from" >&2; exit 2 ;;
esac

ale_run() {
    if [ -n "${ALE_BIN:-}" ]; then
        eval "$ALE_BIN \"\$@\""
    else
        "${ALE_PYTHON:-python3}" -m ale "$@"
    fi
}

export ALE_TASK="$task" ALE_AGENT="$agent"
if [ -n "$base" ]; then
    : "$base"
fi

ale_run claim --task "$task" --agent "$agent"
claim_rc=$?
[ "$claim_rc" -eq 0 ] || exit "$claim_rc"

tmp_root=${TMPDIR:-/tmp}
lost_file=$(mktemp "$tmp_root/ale-exec-lost.XXXXXX") || exit 1
stdout_file=
stdout_fifo=
tee_pid=
child_pid=
loop_pid=
grace_s=${ALE_EXEC_GRACE_S:-10}
signal_exit_code=
loop_marker=${ALE_EXEC_LOOP_MARKER:-ale-exec-heartbeat-loop-$$}

# shellcheck disable=SC2329
cleanup() {
    trap '' INT TERM
    rc=${signal_exit_code:-${ALE_EXEC_EXIT_CODE:-0}}
    if [ -n "$child_pid" ]; then
        kill -TERM "$child_pid" 2>/dev/null || true
        if kill -0 "$child_pid" 2>/dev/null; then
            sleep "$grace_s"
        fi
        if kill -0 "$child_pid" 2>/dev/null; then
            kill -KILL "$child_pid" 2>/dev/null || true
        fi
        wait "$child_pid" 2>/dev/null || true
    fi
    if [ -n "$loop_pid" ]; then
        kill "$loop_pid" 2>/dev/null || true
        wait "$loop_pid" 2>/dev/null || true
    fi
    if [ -n "$tee_pid" ]; then
        kill "$tee_pid" 2>/dev/null || true
        wait "$tee_pid" 2>/dev/null || true
    fi
    [ -n "$stdout_fifo" ] && rm -f "$stdout_fifo"
    [ -n "$stdout_file" ] && rm -f "$stdout_file"
    rm -f "$lost_file"
    trap - EXIT
    exit "$rc"
}
trap 'ALE_EXEC_EXIT_CODE=$?; cleanup' EXIT
trap 'signal_exit_code=130; exit 130' INT
trap 'signal_exit_code=143; exit 143' TERM

# The task tree as it is before the child runs: HEAD plus a checksum of the status and the diff
# against HEAD, so a tree that was already dirty still counts as unchanged when the child left it be.
tree_snapshot() {
    head_rev=$(git rev-parse HEAD 2>/dev/null) || return 0
    top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
    printf '%s %s\n' "$head_rev" "$({
        git status --porcelain
        git diff HEAD
        # status and diff do not see an untracked file's contents: hash those too
        (cd "$top" && git ls-files -o --exclude-standard -z | xargs -0 cksum)
    } 2>/dev/null | cksum)"
}
snapshot_before=$(tree_snapshot)

if [ "$usage_from" != none ]; then
    stdout_file=$(mktemp "$tmp_root/ale-exec-output.XXXXXX") || exit 1
    "$@" > "$stdout_file" &
    child_pid=$!
else
    # No usage capture: still copy stdout to a file (through a FIFO, so the child keeps its own pid
    # and exit status) while streaming it, so a usage-limit stop can be detected.
    stdout_file=$(mktemp "$tmp_root/ale-exec-output.XXXXXX") || exit 1
    stdout_fifo="$stdout_file.fifo"
    if mkfifo "$stdout_fifo" 2>/dev/null; then
        tee "$stdout_file" < "$stdout_fifo" &
        tee_pid=$!
        "$@" > "$stdout_fifo" &
        child_pid=$!
    else
        "$@" &
        child_pid=$!
    fi
fi

export ALE_EXEC_LOST_FILE="$lost_file" ALE_EXEC_HEARTBEAT_S="$heartbeat_s"
sh -c '
    stop_sleep() {
        [ -n "$sleep_pid" ] && kill "$sleep_pid" 2>/dev/null || true
        exit 143
    }
    trap stop_sleep INT TERM
    while kill -0 "$1" 2>/dev/null; do
        eval "${ALE_BIN:-python3 -m ale} heartbeat --task \"$ALE_TASK\" --agent \"$ALE_AGENT\" --auto --step \"process alive\""
        hb_rc=$?
        if [ "$hb_rc" -eq 4 ]; then
            printf "%s\n" lost > "$ALE_EXEC_LOST_FILE"
            kill -TERM "$1" 2>/dev/null || true
            n=0
            while kill -0 "$1" 2>/dev/null && [ "$n" -lt 10 ]; do
                sleep 1
                n=$((n + 1))
            done
            kill -KILL "$1" 2>/dev/null || true
            exit 4
        fi
        sleep "$ALE_EXEC_HEARTBEAT_S" &
        sleep_pid=$!
        wait "$sleep_pid" 2>/dev/null || true
        sleep_pid=
    done
' "$loop_marker" "$child_pid" &
loop_pid=$!

wait "$child_pid"
child_rc=$?
if [ -n "$tee_pid" ]; then
    # tee ends when the child closes the FIFO. Let it drain to EOF, even when the caller reads
    # slowly: cutting it short can lose the final rows, the very ones the usage-limit guard reads.
    # Only a grandchild that keeps stdout open past the child's exit bounds the wait (60 s unless
    # ALE_EXEC_TEE_WAIT_S says otherwise; 1 s after the child was killed by a signal).
    tee_wait_s=${ALE_EXEC_TEE_WAIT_S:-60}
    [ "$child_rc" -gt 128 ] && tee_wait_s=1
    n=0
    while kill -0 "$tee_pid" 2>/dev/null && [ "$n" -lt $((tee_wait_s * 10)) ]; do
        sleep 0.1
        n=$((n + 1))
    done
    if kill -0 "$tee_pid" 2>/dev/null; then
        echo "ale-exec: output still open ${tee_wait_s}s after the child exited; using the capture so far" >&2
    fi
    kill "$tee_pid" 2>/dev/null || true
    wait "$tee_pid" 2>/dev/null || true
    tee_pid=
fi
kill "$loop_pid" 2>/dev/null || true
wait "$loop_pid" 2>/dev/null || true

if [ -s "$lost_file" ]; then
    exit 4
fi

if [ "$usage_from" != none ] && [ -f "$stdout_file" ]; then
    cat "$stdout_file"
    usage_rows=$(python3 - "$stdout_file" "$usage_from" <<'PY'
import json
import sys

path, source = sys.argv[1:]
with open(path, encoding="utf-8") as f:
    for line in f:
        try:
            row = json.loads(line)
        except ValueError:
            continue
        usage = None
        if source == "codex-json" and row.get("type") == "turn.completed":
            usage = row.get("usage")
        elif source == "pi-json" and row.get("type") in ("message_update", "message_end", "turn_end"):
            usage = row.get("usage") or (row.get("message") or {}).get("usage")
        if isinstance(usage, dict):
            if source == "codex-json":
                input_tokens = usage.get("input_tokens", 0)
                output_tokens = usage.get("output_tokens", 0)
                cache_read = usage.get("cached_input_tokens", 0)
                cache_write = usage.get("cache_write_input_tokens", 0)
            else:
                input_tokens = usage.get("input", 0)
                output_tokens = usage.get("output", 0)
                cache_read = usage.get("cacheRead", 0)
                cache_write = usage.get("cacheWrite", 0)
            print("%s\t%s\t%s\t%s" % (input_tokens, output_tokens, cache_read, cache_write))
PY
)
    while IFS="	" read -r input_tokens output_tokens cache_read cache_write; do
        [ -n "$input_tokens" ] || continue
        ale_run usage --task "$task" --agent "$agent" --model "${ALE_MODEL:-unknown}" \
            --input-tokens "$input_tokens" --output-tokens "$output_tokens" \
            --cache-read-tokens "$cache_read" --cache-write-tokens "$cache_write" \
            --source adapter
    done <<EOF
$usage_rows
EOF
fi

# A usage-limit exit is not completed work: skip check and submit so the task stays owned and
# unsubmitted, and a fallback executor can take it over. The signal is an error or turn.failed row
# of the captured JSON output matching the pattern (a limit word in an ordinary row is not one),
# and either the child failed or the task tree is unchanged since the child started (HEAD, status
# and diff all as before, so an initially dirty tree counts; codex's exit
# code on a quota error is not reliable, so a clean exit with no diff counts too).
if [ -n "$stdout_file" ] && [ -f "$stdout_file" ]; then
    limit_line=$(grep -E '"type" *: *"(error|turn\.failed)"' "$stdout_file" 2>/dev/null |
        grep -Ei -m 1 'usage limit|quota exceeded|rate limit|429')
    if [ -n "$limit_line" ]; then
        unchanged=
        if [ -n "$snapshot_before" ] && [ "$(tree_snapshot)" = "$snapshot_before" ]; then
            unchanged=1
        fi
        if [ "$child_rc" -ne 0 ] || [ -n "$unchanged" ]; then
            echo "ale-exec: usage-limit: $limit_line" >&2
            ale_run input-required --task "$task" --agent "$agent" \
                --question "executor usage limit: $limit_line"
            exit 75
        fi
    fi
fi

required_output=$(ale_run check --required --task "$task" --cwd "$(pwd)" 2>&1)
required_rc=$?
if [ "$required_rc" -ne 0 ]; then
    failing=$(printf '%s\n' "$required_output" | awk '/FAIL /{sub(/^FAIL /, ""); print; exit}')
    [ -n "$failing" ] || failing="$required_output"
    ale_run input-required --task "$task" --agent "$agent" \
        --question "Required command failed: $failing"
    exit "$child_rc"
fi

check_output=$(ale_run check --task "$task" --cwd "$(pwd)" 2>&1)
check_rc=$?
if [ "$check_rc" -eq 0 ]; then
    ale_run submit --task "$task" --agent "$agent" --summary "ale-exec completed"
else
    failing=$(printf '%s\n' "$check_output" | awk '/ FAIL exit=/{print}')
    [ -n "$failing" ] || failing="$check_output"
    ale_run input-required --task "$task" --agent "$agent" \
        --question "Acceptance failed: $failing"
fi

exit "$child_rc"
