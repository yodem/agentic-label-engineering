#!/bin/sh

if [ "$#" -ne 1 ]; then
    echo "usage: ale-spawn REQUEST.json" >&2
    exit 2
fi

request=$1
ale_assignments=$(python3 -c '
import json
import shlex
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    request = json.load(handle)
env = request.get("env") or {}
values = {
    "ale_agent": env.get("ALE_AGENT", request.get("agent_id", "")),
    "ale_agent_id": env.get("ALE_AGENT_ID", env.get("ALE_AGENT", request.get("agent_id", ""))),
    "ale_task": env.get("ALE_TASK", ""),
    "ale_kind": request.get("kind", ""),
    "ale_role": request.get("role", ""),
    "ale_executor": request.get("executor", ""),
    "ale_model": request.get("model", ""),
    "ale_cwd": request.get("cwd", ""),
    "ale_prompt": request.get("prompt_file", ""),
    "ale_run_dir": env.get("ALE_RUN_DIR", ""),
    "ale_roster": env.get("ALE_ROSTER", ""),
    "ale_plugin_root": env.get("ALE_PLUGIN_ROOT", ""),
    "ale_import_root": env.get("ALE_IMPORT_ROOT", ""),
    "ale_python": env.get("ALE_PYTHON", ""),
    "ale_read_only": env.get("ALE_READ_ONLY", ""),
    "ale_deny_tools": ",".join(env.get("ALE_DENY_TOOLS", [])),
    "ale_herdr": "",
    "ale_harness": request.get("harness") or "",
    "ale_mode": request.get("mode") or "",
    "ale_host": request.get("host") or "local",
    "ale_herdr_kind": request.get("herdr_kind") or request.get("harness") or "claude",
    "ale_usage_from": request.get("usage_from") or "",
    "ale_remote_worktree": request.get("remote_worktree") or "",
    "ale_argc": 0,
    "ale_argdir": "",
}
# A request written before harness routing names only a legacy executor id: derive the
# harness, mode and argv the same way dispatch does now.
if not values["ale_mode"] or (request.get("argv") is None and values["ale_mode"] == "headless"):
    import os
    sys.path[:0] = [path for path in (env.get("ALE_IMPORT_ROOT"),
                                      os.path.join(os.path.dirname(sys.argv[2]), "..")) if path]
    try:
        from ale import harness as H
    except ImportError:
        H = None
    executor = request.get("executor") or ""
    if H is not None and executor:
        name = request.get("harness") or H.normalize(executor)
        values["ale_harness"] = name
        values["ale_mode"] = values["ale_mode"] or H.mode_hint(executor) or "headless"
        entry = H.registry({}).get(name)
        if entry and request.get("argv") is None:
            prompt = ""
            if os.path.isfile(request.get("prompt_file") or ""):
                with open(request["prompt_file"], encoding="utf-8") as handle:
                    prompt = handle.read()
            request["argv"] = H.render_argv(entry["headless"], request.get("model") or None, prompt)
            values["ale_usage_from"] = values["ale_usage_from"] or entry.get("usage_from") or ""
            values["ale_herdr_kind"] = request.get("herdr_kind") or entry.get("herdr_kind") or "claude"
# The headless argv goes one file per argument (the prompt may hold any byte but NUL);
# the shell rebuilds "$@" from them with set --, so argv text is never evaluated.
argv = request.get("argv")
if isinstance(argv, list) and argv and all(isinstance(arg, str) for arg in argv):
    import tempfile
    argdir = tempfile.mkdtemp(prefix="ale-spawn-")
    for index, arg in enumerate(argv):
        with open("%s/%d" % (argdir, index), "w", encoding="utf-8") as out:
            out.write(arg)
    values["ale_argc"] = len(argv)
    values["ale_argdir"] = argdir
elif argv is not None:
    print("ale-spawn: request argv must be a list of strings", file=sys.stderr)
    sys.exit(2)
for key, value in env.items():
    if key == "ALE_HERDR_EXEC":
        values["ale_herdr"] = value
    elif key == "ALE_PLUGIN_ROOT":
        values["ale_plugin_root"] = value
for key, value in values.items():
    print("%s=%s" % (key, shlex.quote(str(value))))
' "$request" "$0") || exit $?
eval "$ale_assignments"
if [ -n "$ale_argdir" ]; then trap 'rm -rf "$ale_argdir"' EXIT; fi

safe_agent=$(printf '%s' "$ale_agent" | tr '[:upper:].' '[:lower:]-' | sed 's/[^a-z0-9_-]/-/g; s/^[^a-z]*/agent-/; s/\(.*\)\(.\{32\}\)$/\2/')
safe_agent=$(printf '%s' "$safe_agent" | cut -c 1-32)

if [ -n "$ale_task" ]; then ALE_TASK=$ale_task; export ALE_TASK; fi
if [ -n "$ale_agent" ]; then ALE_AGENT=$ale_agent; export ALE_AGENT; fi
if [ -n "$ale_agent_id" ]; then ALE_AGENT_ID=$ale_agent_id; export ALE_AGENT_ID; fi
if [ -n "$ale_run_dir" ]; then ALE_RUN_DIR=$ale_run_dir; export ALE_RUN_DIR; fi
if [ -n "$ale_roster" ]; then ALE_ROSTER=$ale_roster; export ALE_ROSTER; fi
if [ -n "$ale_model" ]; then ALE_MODEL=$ale_model; export ALE_MODEL; fi
if [ -n "$ale_read_only" ]; then ALE_READ_ONLY=$ale_read_only; export ALE_READ_ONLY; fi
plugin_root=${ALE_PLUGIN_ROOT:-$ale_plugin_root}
if [ -z "$plugin_root" ]; then plugin_root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd); fi
ALE_PLUGIN_ROOT=$plugin_root
export ALE_PLUGIN_ROOT
import_root=${ALE_IMPORT_ROOT:-${ale_import_root:-$plugin_root}}
ALE_IMPORT_ROOT=$import_root
export ALE_IMPORT_ROOT
ALE_PYTHON=${ALE_PYTHON:-${ale_python:-python3}}
export ALE_PYTHON
if [ "$ALE_PYTHON" = python3 ]; then
    ALE_BIN=${ALE_BIN:-python3 -m ale}
else
    ALE_BIN=${ALE_BIN:-"'$ALE_PYTHON' -m ale"}
fi
export ALE_BIN
case ":${PYTHONPATH:-}:" in
    *":$import_root:"*) ;;
    *) PYTHONPATH="$import_root${PYTHONPATH:+:$PYTHONPATH}" ;;
esac
export PYTHONPATH

print_argv() {
    printf '%s' "$1"
    shift
    for arg in "$@"; do
        printf ' '
        printf '%s' "$arg" | tr '\n' ' '
    done
    printf '\n'
}

run_argv() {
    if [ "${ALE_SPAWN_DRY:-0}" = "1" ]; then
        print_argv "$@"
        printf 'ALE_BIN=%s\nPYTHONPATH=%s\n' "$ALE_BIN" "$PYTHONPATH"
        if [ -n "$ALE_READ_ONLY" ]; then printf 'ALE_READ_ONLY=%s\n' "$ALE_READ_ONLY"; fi
        return 0
    fi
    "$@"
}

herdr_run() {
    if [ -n "$herdr_host" ]; then
        run_argv python3 "$herdr_exec" --host "$herdr_host" "$@"
    else
        run_argv python3 "$herdr_exec" "$@"
    fi
}

case "$ale_mode" in
    headless)
        if [ "$ale_host" != local ]; then
            echo "ale-spawn: headless mode cannot run on remote host $ale_host" >&2
            exit 2
        fi
        if [ "$ale_argc" -eq 0 ]; then
            echo "ale-spawn: unknown executor: ${ale_harness:-$ale_executor} (no headless argv)" >&2
            exit 2
        fi
        # Rebuild "$@" from the request argv, one argument per file (never evaluated).
        set --
        i=0
        while [ "$i" -lt "$ale_argc" ]; do
            arg=$(cat "$ale_argdir/$i"; printf x)
            arg=${arg%x}
            set -- "$@" "$arg"
            if [ "$i" -eq 0 ] && [ "$ale_harness" = claude ]; then
                if [ -n "$ALE_PLUGIN_ROOT" ]; then set -- "$@" --plugin-dir "$ALE_PLUGIN_ROOT"; fi
                if [ "$ale_kind" = "monitor" ] && [ "$ALE_READ_ONLY" = "1" ]; then
                    ale_deny_tools=${ale_deny_tools:+$ale_deny_tools,}
                    ale_deny_tools="${ale_deny_tools}Write,Edit,MultiEdit,NotebookEdit"
                fi
                if [ -n "$ale_deny_tools" ]; then set -- "$@" --disallowedTools "$ale_deny_tools"; fi
            fi
            i=$((i + 1))
        done
        rm -rf "$ale_argdir"
        if [ -n "$ale_task" ]; then
            if [ -n "$ale_usage_from" ]; then
                set -- --usage-from "$ale_usage_from" -- "$@"
            else
                set -- -- "$@"
            fi
            run_argv "$(dirname "$0")/ale-exec" --task "$ale_task" --agent "$ale_agent" "$@" </dev/null
        else
            run_argv "$@" </dev/null
        fi
        ;;
    pane)
        [ -n "${ALE_HERDR_EXEC:-$ale_herdr}" ] || {
            echo "ale-spawn: ALE_HERDR_EXEC is required" >&2
            exit 2
        }
        herdr_exec=${ALE_HERDR_EXEC:-$ale_herdr}
        if [ "$ale_host" != local ]; then
            herdr_host=$ale_host
            pane_cwd=$ale_remote_worktree
            [ -n "$pane_cwd" ] || {
                echo "ale-spawn: host $ale_host needs the request's remote_worktree (remote worktree not provisioned)" >&2
                exit 2
            }
        else
            herdr_host=${ALE_HERDR_HOST:-}
            pane_cwd=$ale_cwd
        fi
        herdr_run start "$safe_agent" --kind "$ale_herdr_kind" --cwd "$pane_cwd" || exit $?
        herdr_run send "$safe_agent" --spec "$ale_prompt"
        ;;
    *)
        echo "ale-spawn: unknown mode: $ale_mode" >&2
        exit 2
        ;;
esac
