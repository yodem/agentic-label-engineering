{
  "$comment": "Each event type maps to the keys it must carry. $optional names keys a type may carry: they are never required, so events written before them stay valid.",
  "$optional": {
    "integrated": ["noop"]
  },
  "label_vote": ["field", "by", "value"],
  "shadow_vote": ["decision", "options", "choice", "confidence", "model", "latency_ms"],
  "decision_outcome": ["decision", "choice", "source"],
  "labeled": ["labels", "roster_hash"],
  "relabeled": ["field", "old", "new", "reason"],
  "adjudicated": ["field", "value", "by"],
  "heartbeat": ["step"],
  "note": ["text"],
  "input_required": ["question"],
  "input_answered": ["text"],
  "submitted": ["summary"],
  "verified": ["evidence"],
  "accepted": ["evidence"],
  "rejected": ["evidence", "reason"],
  "failed": ["reason"],
  "breach": ["breach", "detail"],
  "usage": ["gen_ai.request.model", "gen_ai.usage.input_tokens", "gen_ai.usage.output_tokens", "usage_source"],
  "decision": ["text"],
  "monitor_verdict": ["agent_id_minted", "verdict", "text"],
  "restack_needed": ["parent", "base_commit"],
  "restacked": ["parent", "old_base", "new_base"],
  "refs_fetched": ["key", "path", "ok", "bytes", "token"],
  "refs_read": ["via", "summary", "token_ok"]
}
