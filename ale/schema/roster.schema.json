{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vocab", "routing", "watch_defaults", "uncertain_below", "judge", "promotion", "cost_gate"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "vocab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "model_tier", "risk", "effort"],
      "properties": {
        "role": {"type": "object"},
        "model_tier": {"type": "object"},
        "risk": {"type": "object"},
        "effort": {"type": "object"},
        "locality": {"type": "object"},
        "sub": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}}},
        "cross_sub": {"type": "array", "items": {"type": "string"}},
        "phase": {"type": "array", "items": {"type": "string", "enum": ["plan", "design", "implement", "test", "review", "deploy", "operate", "maintain"]}}
      }
    },
    "routing": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "model_tier", "executor", "model"],
        "properties": {
          "role": {"type": "string"},
          "model_tier": {"type": "string"},
          "executor": {"type": "string"},
          "model": {"type": "string"}
        }
      }
    },
    "watch_defaults": {"type": "object"},
    "worktree_setup_defaults": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "when", "value"],
        "properties": {
          "field": {"enum": ["role", "model_tier", "risk", "effort", "locality"]},
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path_prefix": {"type": "string", "minLength": 1},
              "keyword": {"type": "string", "minLength": 1}
            }
          },
          "value": {"type": "string", "minLength": 1}
        }
      }
    },
    "uncertain_below": {"type": "number", "minimum": 0},
    "judge": {
      "type": "object",
      "required": ["plugin", "threshold", "modes"],
      "properties": {
        "default": {"enum": ["off", "shadow"]},
        "plugin": {"type": ["string", "null"]},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "questions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {"type": "string", "minLength": 1},
            "model_tier": {"type": "string", "minLength": 1},
            "risk": {"type": "string", "minLength": 1},
            "effort": {"type": "string", "minLength": 1},
            "locality": {"type": "string", "minLength": 1},
            "sub": {"type": "string", "minLength": 1},
            "phase": {"type": "string", "minLength": 1},
            "over_an_hour": {"type": "string", "minLength": 1},
            "unattended": {"type": "string", "minLength": 1},
            "external_side_effects": {"type": "string", "minLength": 1},
            "rejection_environment": {"type": "string", "minLength": 1},
            "rejection_spec_conflict": {"type": "string", "minLength": 1},
            "rejection_needs_human": {"type": "string", "minLength": 1},
            "monitor_reports_defect": {"type": "string", "minLength": 1},
            "monitor_agent_blocked": {"type": "string", "minLength": 1},
            "monitor_unsafe": {"type": "string", "minLength": 1}
          }
        },
        "model": {"type": "string", "minLength": 1},
        "timeout_s": {"type": "integer", "minimum": 1},
        "threshold": {"type": "number", "minimum": 0},
        "bar": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_cases", "min_agreement", "max_instability"],
          "properties": {
            "min_cases": {"const": 100},
            "min_agreement": {"type": "number", "minimum": 0},
            "max_instability": {"const": 0.1}
          }
        },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {"enum": ["off", "shadow", "authoritative"]},
            "model_tier": {"enum": ["off", "shadow", "authoritative"]},
            "risk": {"enum": ["off", "shadow", "authoritative"]},
            "effort": {"enum": ["off", "shadow", "authoritative"]},
            "locality": {"enum": ["off", "shadow", "authoritative"]},
            "sub": {"enum": ["off", "shadow", "authoritative"]},
            "phase": {"enum": ["off", "shadow", "authoritative"]}
          }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_cases", "tolerance", "min_coverage", "demote_window"],
      "properties": {
        "min_cases": {"type": "integer", "minimum": 1},
        "tolerance": {"type": "number", "minimum": 0},
        "min_coverage": {"type": "number", "minimum": 0},
        "demote_window": {"type": "integer", "minimum": 1}
      }
    },
    "cost_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrent", "max_tasks_per_run", "max_run_budget_tokens"],
      "properties": {
        "max_concurrent": {"type": "integer", "minimum": 1},
        "max_tasks_per_run": {"type": "integer", "minimum": 1},
        "max_run_budget_tokens": {"type": "integer", "minimum": 1000}
      }
    }
  }
}
