{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "task_id", "title", "labels", "routing", "context", "acceptance", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,40}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 200},
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "model_tier", "lane", "risk", "effort"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "model_tier": {"type": "string", "minLength": 1},
        "lane": {"type": ["string", "null"], "enum": ["inline", "workflow", "pane", null]},
        "risk": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "model", "resolved_from"],
      "properties": {
        "executor": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "resolved_from": {"type": ["string", "null"]}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_path", "pointers", "allowed_paths", "depends_on"],
      "properties": {
        "spec_path": {"type": "string", "minLength": 1},
        "pointers": {"type": "array", "items": {"type": "string"}},
        "allowed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "worktree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "branch", "base", "worktree_reason"],
          "properties": {
            "mode": {"enum": ["per_task", "shared", "none"]},
            "branch": {"type": ["string", "null"]},
            "base": {"type": ["string", "null"]},
            "worktree_reason": {"type": ["string", "null"]}
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "cmd", "expect"],
            "properties": {
              "id": {"type": "string", "pattern": "^A[0-9]+$"},
              "cmd": {"type": "string", "minLength": 1},
              "expect": {"type": "string", "pattern": "^exit(0|:[0-9]{1,3})$"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "manual"],
            "properties": {
              "id": {"type": "string", "pattern": "^A[0-9]+$"},
              "manual": {"type": "string", "minLength": 5}
            }
          }
        ]
      }
    },
    "watch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heartbeat_timeout_s": {"type": "integer", "minimum": 30},
        "stuck_after_s": {"type": "integer", "minimum": 30},
        "max_duration_s": {"type": "integer", "minimum": 60},
        "budget_tokens": {"type": "integer", "minimum": 1000},
        "max_attempts": {"type": "integer", "minimum": 1}
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "role", "model_tier", "executor", "trigger"],
        "properties": {
          "kind": {"enum": ["executor", "monitor", "fixer"]},
          "role": {"type": "string", "minLength": 1},
          "model_tier": {"type": "string", "minLength": 1},
          "executor": {"type": ["string", "null"]},
          "trigger": {"enum": ["ready", "on_breach", "on_submit", "milestone"]}
        }
      }
    },
    "fixes": {"type": "string"},
    "provenance": {
      "type": "object",
      "required": ["lane_reason"],
      "properties": {
        "lane_reason": {"type": ["string", "null"], "minLength": 10}
      }
    }
  }
}
