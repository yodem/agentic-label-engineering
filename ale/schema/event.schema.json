{
  "type": "object",
  "required": ["schema_version", "ts", "run_id", "task_id", "agent_id", "attempt", "type"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "ts": {"type": "number", "minimum": 0},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": ["string", "null"]},
    "agent_id": {"type": ["string", "null"]},
    "attempt": {"type": ["integer", "null"]},
    "type": {"enum": ["run_started", "label_vote", "shadow_vote", "decision_outcome", "labeled", "relabeled", "adjudicated", "dispatched", "claimed", "heartbeat", "note", "input_required", "input_answered", "relayed", "submitted", "verified", "accepted", "rejected", "failed", "canceled", "lease_expired", "released", "breach", "monitor_verdict", "usage", "decision", "run_finished", "task_added", "label_changed", "label_removed", "spawned", "integrated"]},
    "verdict": {"enum": ["continue", "nudge", "fix", "escalate"]},
    "agent_id_minted": {"type": "string", "minLength": 1},
    "text": {"type": "string", "maxLength": 1500},
    "decision": {"type": "string", "minLength": 1},
    "options": {"type": "array", "items": {"type": "string"}},
    "choice": {},
    "confidence": {"type": ["number", "null"]},
    "model": {"type": ["string", "null"]},
    "latency_ms": {"type": ["number", "null"]},
    "authority": {"enum": ["lead", "planner", "dispatcher", "monitor", "run_loop"]},
    "additive": {"type": "boolean"},
    "source": {"type": "string"},
    "uncertain": {"type": ["boolean", "null"]},
    "answers": {"type": "object"},
    "rule": {"type": ["string", "null"]},
    "bake_id": {"type": "string"},
    "calls_latency_ms": {"type": "array", "items": {"type": "number"}}
  }
}
