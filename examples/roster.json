{
  "schema_version": "1.0",
  "vocab": {
    "role": {
      "backend": "Server code, APIs, data access, scripts.",
      "frontend": "UI components, styling, client state.",
      "infra": "CI, deployment, containers, cloud config.",
      "test": "Test suites, fixtures, coverage work.",
      "docs": "Documentation and written guides only."
    },
    "model_tier": {
      "cheap": "Mechanical edits with a clear recipe.",
      "standard": "Ordinary implementation work that needs judgment.",
      "frontier": "Architecture, ambiguous requirements, security-sensitive work."
    },
    "risk": {
      "low": "Reversible, covered by tests.",
      "medium": "Touches shared interfaces or data shape.",
      "high": "Auth, money, deletion, migrations. Needs sign-off before acceptance."
    },
    "effort": {"S": "Under 15 minutes.", "M": "15 to 60 minutes.", "L": "Over an hour."}
  },
  "routing": [
    {"role": "*", "model_tier": "cheap", "executor": "claude_code", "model": "claude-haiku-4-5-20251001"},
    {"role": "*", "model_tier": "standard", "executor": "claude_code", "model": "claude-sonnet-5"},
    {"role": "*", "model_tier": "frontier", "executor": "claude_code", "model": "claude-opus-5"}
  ],
  "watch_defaults": {
    "*:S": {"heartbeat_timeout_s": 600, "stuck_after_s": 600, "max_duration_s": 1800, "budget_tokens": 150000, "max_attempts": 3},
    "*:M": {"heartbeat_timeout_s": 900, "stuck_after_s": 1200, "max_duration_s": 5400, "budget_tokens": 400000, "max_attempts": 3},
    "*:L": {"heartbeat_timeout_s": 900, "stuck_after_s": 1800, "max_duration_s": 10800, "budget_tokens": 900000, "max_attempts": 3}
  },
  "uncertain_below": 0.6,
  "judge": {"plugin": null, "threshold": 0.75, "modes": {"role": "off", "model_tier": "off", "risk": "off", "effort": "off"}},
  "promotion": {"min_cases": 100, "tolerance": 0.03, "min_coverage": 0.6, "demote_window": 50},
  "cost_gate": {"max_concurrent": 3, "max_tasks_per_run": 20, "max_run_budget_tokens": 3000000}
}
